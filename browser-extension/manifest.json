{
  "manifest_version": 3,
  "name": "Drifty browser context",
  "version": "0.1.0",
  "minimum_chrome_version": "106",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "scripting",
    "tabs",
    "webNavigation",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  }
}
