    "--tools",
    "",
    "--strict-mcp-config",
    "--setting-sources",
    "local",
    "--mcp-config",
    "{\"mcpServers\":{\"drifty\":{\"args\":[\"--db\",\"/Users/me/Library/Application Support/so.drifty.mac/tracker.sqlite3\",\"mcp\",\"--detail\",\"titles\"],\"command\":\"/Applications/Drifty.app/Contents/MacOS/drifty-tracker\",\"type\":\"stdio\"}}}",
    "--allowedTools",
    "mcp__drifty__summary,mcp__drifty__search,mcp__drifty__timeline",
