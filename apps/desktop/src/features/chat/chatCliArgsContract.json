{
  "description": "Expected agent CLI arguments for one Chat turn. src-tauri chat_cli.rs (native) and vitePreviewChatBridge.ts (browser preview) must both build exactly these. codexFeaturesList is sample output of codex features list.",
  "input": {
    "toolProgram": "/Applications/Drifty.app/Contents/MacOS/drifty-tracker",
    "toolLeadingArgs": [],
    "database": "/Users/me/Library/Application Support/so.drifty.mac/tracker.sqlite3",
    "detail": "titles",
    "workingDirectory": "/tmp/drifty-chat",
    "instructions": "Answer only from the user's Drifty records.",
    "prompt": "-v What did I do \"yesterday\"?",
    "codexFeaturesList": [
      "apps                                     stable             true",
      "code_mode                                under development  false",
      "code_mode_host                           stable             true",
      "fast_mode                                stable             true",
      "js_repl                                  removed            false",
      "multi_agent                              stable             true",
      "shell_tool                               stable             true",
      "view_image                               stable             true"
    ]
  },
  "codex": [
    "exec",
    "--json",
    "--ephemeral",
    "--skip-git-repo-check",
    "--ignore-user-config",
    "--ignore-rules",
    "--disable",
    "shell_tool",
    "--disable",
    "view_image",
    "--disable",
    "multi_agent",
    "--disable",
    "apps",
    "--sandbox",
    "read-only",
    "-C",
    "/tmp/drifty-chat",
    "-c",
    "web_search=\"disabled\"",
    "-c",
    "mcp_servers.drifty.command=\"/Applications/Drifty.app/Contents/MacOS/drifty-tracker\"",
    "-c",
