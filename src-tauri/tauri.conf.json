{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drifty",
  "version": "0.1.1",
  "identifier": "so.drifty.mac",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "drifty",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 28,
          "y": 19
        },
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "main-window",
        "watcher-window",
        "drift-alarm-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../services/tracker-python/app"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 640,
          "height": 400
        },
        "windowPosition": {
          "x": 160,
          "y": 120
        },
        "appPosition": {
          "x": 190,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 200
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "drifty"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDOTg4Q0Q2RUI1RTU2RjAKUldUd1ZsN3Ixb3lZekhueE9VQVpXUi9wdjZUSkRKUWZUNjB0aXJDOUc3Q2RsSGlOUHV0cG1yeFgK",
      "endpoints": [
        "https://github.com/edgethink00/drifty_releases/releases/latest/download/latest.json"
      ]
    }
  }
}
