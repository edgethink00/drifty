{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "drifty",
  "version": "1.6.8",
  "identifier": "so.drifty.mac",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "drifty",
        "width": 1254,
        "height": 809,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "backgroundColor": "#00000000",
        "windowEffects": {
          "effects": [
            "hudWindow"
          ],
          "state": "active"
        },
        "trafficLightPosition": {
          "x": 14,
          "y": 19
        },
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-WNwUZmOqeOaTx3GY4ckc4gx7BDSAFLpP9ysv5K3EYwU='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://*.supabase.co https://images.unsplash.com; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co https://us.i.posthog.com https://openrouter.ai; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleusercontent.com https://*.supabase.co https://images.unsplash.com; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420 https://*.supabase.co https://us.i.posthog.com https://openrouter.ai; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": [
        "main-window",
        "watcher-window",
        "companion-window",
        "drift-alarm-window",
        "pet-mode-window"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../integrations/skills/drifty/SKILL.md": "integrations/skills/drifty/SKILL.md",
      "../integrations/skills/drifty/agents/openai.yaml": "integrations/skills/drifty/agents/openai.yaml"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 160,
          "y": 120
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "drifty"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QUI1Q0UxNUIwNzcwNjAKUldSZ2NBZGI0VnlyK0ZjbG92YTdQNkJseGk3Qjd2QkpJQU00cmRndHl5YXhOODZjZVFwMytYdlgK",
      "endpoints": [
        "https://github.com/edgethink00/drifty_releases/releases/latest/download/latest.json"
      ]
    }
  }
}
