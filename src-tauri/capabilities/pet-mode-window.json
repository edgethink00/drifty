{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pet-mode-window",
  "description": "Least-privilege capability for the pet overlay window.",
  "windows": [
    "pet-mode"
  ],
  "platforms": [
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "allow-pet-mode-move-to-target",
    "allow-pet-mode-align-contact",
    "allow-pet-mode-report-contact",
    "allow-pet-mode-report-pointer",
    "allow-pet-mode-return-home",
    "allow-pet-mode-set-presence",
    "allow-pet-mode-set-interactive",
    "allow-pet-mode-update-hit-region",
    "allow-pet-mode-cancel-motion",
    "allow-pet-mode-begin-drag",
    "allow-pet-mode-report-drag-error",
    "allow-pet-mode-cursor-inside",
    "allow-pet-mode-cursor-sample",
    "allow-pet-mode-input-bounds",
    "allow-pet-mode-roam",
    "allow-pet-mode-exit-screen",
    "allow-pet-mode-return-from-outing",
    "allow-pet-mode-remember-position",
    "allow-pet-mode-preview-action",
    "allow-pet-mode-resolve-drop",
    "allow-pet-mode-visibility-action",
    "allow-watcher-peek-end-of-day-review-action"
  ]
}
