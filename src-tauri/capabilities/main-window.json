{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capability for the main Drifty desktop window.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "deep-link:allow-get-current",
    "allow-accessibility-get-status",
    "allow-accessibility-request-access",
    "allow-ai-classification-openai-chat",
    "allow-tracker-get-status",
    "allow-tracker-start",
    "allow-tracker-stop",
    "allow-tracker-get-timeline",
    "allow-tracker-get-current-snapshot",
    "allow-tracker-get-hourly-summary",
    "allow-tracker-get-raw-events",
    "allow-tracker-get-top-sites",
    "allow-tracker-get-app-icons",
    "allow-tracker-get-unclassified-segments",
    "allow-tracker-get-reusable-ai-classifications",
    "allow-tracker-get-classification-rules",
    "allow-tracker-save-classification-rule",
    "allow-tracker-delete-classification-rule",
    "allow-tracker-delete-activity-segments",
    "allow-tracker-search-classification-rule-candidates",
    "allow-tracker-apply-classification-rules",
    "allow-tracker-save-classifications",
    "allow-tracker-refresh-non-ai-classifications",
    "allow-tracker-get-classification-metrics",
    "allow-tray-update-productivity-icon",
    "allow-auth-take-pending-deep-links",
    "allow-auth-load-saved-session",
    "allow-auth-save-session",
    "allow-auth-clear-saved-session",
    "allow-focus-target-activate-browser-tab",
    "allow-focus-target-open-app",
    "allow-extreme-nudge-apply",
    "allow-system-open-settings-pane",
    "allow-watcher-peek-show",
    "allow-watcher-peek-hide",
    "allow-drift-alarm-show",
    "allow-drift-alarm-hide",
    "core:event:allow-listen"
  ]
}
