{
  "name": "drifty",
  "version": "1.9.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri:dev",
    "dev:web": "npm --prefix apps/desktop run dev",
    "dev:web:skip-onboarding": "SKIP_ONBOARDING=1 npm run dev:web",
    "dev:web:auth-required": "VITE_DRIFTY_AUTH_MODE=required npm --prefix apps/desktop run dev",
    "build:web": "npm --prefix apps/desktop run build",
    "build:tracker-sidecar": "node scripts/build-tracker-sidecar.mjs",
    "typecheck": "npm --prefix apps/desktop run typecheck",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:rust": "node scripts/run-rust-tests.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:dev:isolated": "sh scripts/tauri-dev-isolated.sh",
    "tauri:dev:onboarding": "FORCE_ONBOARDING=1 ALLOW_ONBOARDING_AUTH_SKIP=1 VITE_DRIFTY_AUTH_MODE=optional npm run tauri:dev",
    "tauri:dev:skip-onboarding": "SKIP_ONBOARDING=1 npm run tauri:dev",
    "tauri:dev:auth-optional": "VITE_DRIFTY_AUTH_MODE=optional npm run tauri:dev",
    "tauri:build": "node scripts/run-tauri.mjs build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.1",
    "playwright": "^1.60.0"
  },
  "license": "AGPL-3.0-only"
}
